{
  "name": "oto-eum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based toolkit for 音MAD / YTPMV creators",
  "scripts": {
    "predev": "node scripts/copy-models.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-models.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "test:e2e": "node scripts/copy-models.mjs && node tests/e2e/run.mjs && node tests/e2e/ui.mjs"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "idb-keyval": "^6.3.0",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.8",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
